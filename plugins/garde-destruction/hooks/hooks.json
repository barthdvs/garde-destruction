{
  "modules": [
    "./garde.ts"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/garde.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/garde.py\" 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
